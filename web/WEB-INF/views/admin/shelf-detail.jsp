<%-- Trang chi tiết kệ do ShelfManagementServlet hiển thị; nhận shelf cùng shelf.bookCopies. --%>
<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<c:set var="isManagePageAttr" value="true" scope="request"/><c:set var="activePage" value="shelf" scope="request"/><c:set var="pageTitle" value="Chi tiết kệ – FPT Library" scope="request"/><c:set var="pageStylesheet" value="/assets/css/shelf-map.css" scope="request"/><%@ include file="/WEB-INF/views/fragments/header.jsp" %>
<main class="shelf-page"><div class="shelf-content"><a class="back" href="${pageContext.request.contextPath}${rolePath}/shelf">← Quay lại danh sách</a><section class="detail-head"><div><span>${shelf.code}</span><h1><c:out value="${shelf.name}"/></h1><p><c:out value="${shelf.area}"/> · Tầng ${shelf.floorNumber}</p></div><a class="btn btn-primary" href="${pageContext.request.contextPath}${rolePath}/shelf/edit?id=${shelf.id}">Sửa kệ</a></section><div class="metrics"><article><strong>${shelf.capacity}</strong><span>Sức chứa</span></article><article><strong>${shelf.bookCount}</strong><span>Số sách hiện tại</span></article><article><strong>${shelf.availableSlots}</strong><span>Vị trí còn trống</span></article></div><section class="shelf-table-wrap"><h2>Sách đang nằm trên kệ</h2><table class="shelf-table"><thead><tr><th>Barcode</th><th>Đầu sách</th><th>ISBN</th><th>Ngăn</th><th>Trạng thái</th></tr></thead><tbody><c:choose><c:when test="${empty shelf.bookCopies}"><tr><td colspan="5" class="empty">Kệ chưa có sách.</td></tr></c:when><c:otherwise><c:forEach var="copy" items="${shelf.bookCopies}"><tr><td><c:out value="${copy.barcode}"/></td><td><c:out value="${copy.book.title}"/></td><td><c:out value="${copy.book.isbn}"/></td><td><c:out value="${copy.slot}"/></td><td><c:out value="${copy.status}"/></td></tr></c:forEach></c:otherwise></c:choose></tbody></table></section></div></main><%@ include file="/WEB-INF/views/fragments/footer.jsp" %>
