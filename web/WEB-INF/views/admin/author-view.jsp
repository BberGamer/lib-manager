<%-- Trang chi tiết tác giả do AuthorServlet hiển thị; nhận request attribute author. --%>
<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions" %>
<c:set var="isManagePageAttr" value="true" scope="request" /><c:set var="activePage" value="authors" scope="request" /><c:set var="pageTitle" value="Chi tiết tác giả – FPT Library" scope="request" /><c:set var="pageStylesheet" value="/assets/css/author.css" scope="request" /><%@ include file="/WEB-INF/views/fragments/header.jsp" %>
<c:url var="authorListUrl" value="/admin/authors" /><c:url var="editUrl" value="/admin/authors/edit"><c:param name="id" value="${author.id}" /></c:url>
<main class="author-management author-editor"><div class="author-form-content"><a class="author-back" href="${authorListUrl}"><i class="fa-solid fa-arrow-left"></i> Quay lại danh sách tác giả</a><div class="author-form-title"><span class="author-eyebrow"><i class="fa-solid fa-eye"></i> Chi tiết</span><h1>Chi tiết tác giả</h1><p>Thông tin hồ sơ và dữ liệu kiểm toán của tác giả.</p></div>
<section class="author-detail-card"><header><span class="author-detail-avatar"><c:choose><c:when test="${not empty author.avatarUrl}"><img src="${fn:escapeXml(author.avatarUrl)}" alt="Ảnh ${fn:escapeXml(author.name)}"></c:when><c:otherwise><c:out value="${fn:substring(author.name,0,1)}" /></c:otherwise></c:choose></span><div><h2><c:out value="${author.name}" /></h2><p>ID #<c:out value="${author.id}" /></p></div></header><dl>
<div><dt>Quốc tịch</dt><dd><c:out value="${empty author.nationality ? '—' : author.nationality}" /></dd></div><div><dt>Ngày sinh</dt><dd><c:out value="${empty author.birthDate ? '—' : author.birthDate}" /></dd></div><div><dt>Tiểu sử</dt><dd><c:out value="${empty author.bio ? 'Chưa có tiểu sử' : author.bio}" /></dd></div><div><dt>URL ảnh</dt><dd><c:out value="${empty author.avatarUrl ? '—' : author.avatarUrl}" /></dd></div><div><dt>Người tạo</dt><dd><c:out value="${empty author.createdBy ? '—' : author.createdBy}" /></dd></div><div><dt>Ngày tạo</dt><dd><c:out value="${author.createdAt}" /></dd></div><div><dt>Cập nhật bởi</dt><dd><c:out value="${empty author.updatedBy ? '—' : author.updatedBy}" /></dd></div><div><dt>Cập nhật lần cuối</dt><dd><c:out value="${author.updatedAt}" /></dd></div>
</dl></section><div class="author-detail-actions"><a class="author-button secondary" href="${authorListUrl}"><i class="fa-solid fa-list"></i> Tất cả tác giả</a><a class="author-button primary" href="${editUrl}"><i class="fa-solid fa-pen"></i> Chỉnh sửa tác giả</a></div></div></main><%@ include file="/WEB-INF/views/fragments/footer.jsp" %>
