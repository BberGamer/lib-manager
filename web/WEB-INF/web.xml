<?xml version="1.0" encoding="UTF-8"?>

<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
	 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	 xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
	 version="6.0">

    <display-name>FPT Library Management System</display-name>

    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>controller.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DashboardServlet</servlet-name>
        <servlet-class>controller.DashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DashboardServlet</servlet-name>
        <url-pattern>/dashboard/library</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>DashboardServlet</servlet-name>
        <url-pattern>/admin/dashboard/library</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>DashboardServlet</servlet-name>
        <url-pattern>/librarian/dashboard/library</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>DashboardServlet</servlet-name>
        <url-pattern>/dashboard/admin</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>DashboardServlet</servlet-name>
        <url-pattern>/admin</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>BookListServlet</servlet-name>
        <servlet-class>controller.BookListServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BookListServlet</servlet-name>
        <url-pattern>/books</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>BookListServlet</servlet-name>
        <url-pattern>/admin/books</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>BookListServlet</servlet-name>
        <url-pattern>/librarian/books</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>BorrowManagementServlet</servlet-name>
        <servlet-class>controller.BorrowManagementServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BorrowManagementServlet</servlet-name>
        <url-pattern>/admin/borrow/list</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>BorrowManagementServlet</servlet-name>
        <url-pattern>/librarian/borrow/list</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>BorrowManagementServlet</servlet-name>
        <url-pattern>/admin/borrow/confirm-pickup</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>BorrowManagementServlet</servlet-name>
        <url-pattern>/librarian/borrow/confirm-pickup</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>BorrowManagementServlet</servlet-name>
        <url-pattern>/admin/borrow/confirm-return</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>BorrowManagementServlet</servlet-name>
        <url-pattern>/librarian/borrow/confirm-return</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ReservationManagementServlet</servlet-name>
        <servlet-class>controller.ReservationManagementServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReservationManagementServlet</servlet-name>
        <url-pattern>/admin/reservation/list</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ReservationManagementServlet</servlet-name>
        <url-pattern>/librarian/reservation/list</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ReservationManagementServlet</servlet-name>
        <url-pattern>/admin/reservation/update</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ReservationManagementServlet</servlet-name>
        <url-pattern>/librarian/reservation/update</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>FineManagementServlet</servlet-name>
        <servlet-class>controller.FineManagementServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FineManagementServlet</servlet-name>
        <url-pattern>/admin/fine/list</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>FineManagementServlet</servlet-name>
        <url-pattern>/librarian/fine/list</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>FineManagementServlet</servlet-name>
        <url-pattern>/admin/fine/create</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>FineManagementServlet</servlet-name>
        <url-pattern>/librarian/fine/create</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>FineManagementServlet</servlet-name>
        <url-pattern>/admin/fine/update-status</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>FineManagementServlet</servlet-name>
        <url-pattern>/librarian/fine/update-status</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ShelfManagementServlet</servlet-name>
        <servlet-class>controller.ShelfManagementServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ShelfManagementServlet</servlet-name>
        <url-pattern>/admin/shelf</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ShelfManagementServlet</servlet-name>
        <url-pattern>/librarian/shelf</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ShelfManagementServlet</servlet-name>
        <url-pattern>/admin/shelf/update</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ShelfManagementServlet</servlet-name>
        <url-pattern>/librarian/shelf/update</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>NotificationManagementServlet</servlet-name>
        <servlet-class>controller.NotificationManagementServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>NotificationManagementServlet</servlet-name>
        <url-pattern>/admin/notification/manage</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>NotificationManagementServlet</servlet-name>
        <url-pattern>/librarian/notification/manage</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>NotificationManagementServlet</servlet-name>
        <url-pattern>/admin/notification/send</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>NotificationManagementServlet</servlet-name>
        <url-pattern>/librarian/notification/send</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>NotificationInboxServlet</servlet-name>
        <servlet-class>controller.NotificationInboxServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>NotificationInboxServlet</servlet-name>
        <url-pattern>/notification/my</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>NotificationInboxServlet</servlet-name>
        <url-pattern>/notification/read</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>NotificationInboxServlet</servlet-name>
        <url-pattern>/notification/read-all</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>home</welcome-file>
    </welcome-file-list>
</web-app>
